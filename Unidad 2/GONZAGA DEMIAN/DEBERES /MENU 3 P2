#include <stdio.h>
#include <stdlib.h>

int main() {
    int opcion;
    int anio, mes, dia, maxDias;
    int n, i, a, b;
    char letraSup, letraInf;

    do {
        system("cls");
        printf("MENU\n");
        printf("1. Validar fecha\n");
        printf("2. Desplegar serie letras\n");
        printf("3. Desplegar serie numero\n");
        printf("4. Salir\n");
        printf("Ingrese opcion: ");
        if (scanf("%d", &opcion) != 1) {
            opcion = 0;
        }
        while (getchar() != '\n');

        switch (opcion) {
            case 1:
                do {
                    printf("\nIngrese el anio (1900 - 2015): ");
                    if (scanf("%d", &anio) != 1) {
                        anio = 0;
                    }
                    while (getchar() != '\n');
                } while (anio < 1900 || anio > 2015);

                do {
                    printf("Ingrese el mes (1 - 12): ");
                    if (scanf("%d", &mes) != 1) {
                        mes = 0;
                    }
                    while (getchar() != '\n');
                } while (mes < 1 || mes > 12);

                if (mes == 4 || mes == 6 || mes == 9 || mes == 11) {
                    maxDias = 30;
                } else if (mes == 2) {
                    maxDias = 29;
                } else {
                    maxDias = 31;
                }

                do {
                    printf("Ingrese el dia (1 - %d): ", maxDias);
                    if (scanf("%d", &dia) != 1) {
                        dia = 0;
                    }
                    while (getchar() != '\n');
                } while (dia < 1 || dia > maxDias);

                printf("\nFecha valida: %d de ", dia);
                switch (mes) {
                    case 1: printf("Enero"); break;
                    case 2: printf("Febrero"); break;
                    case 3: printf("Marzo"); break;
                    case 4: printf("Abril"); break;
                    case 5: printf("Mayo"); break;
                    case 6: printf("Junio"); break;
                    case 7: printf("Julio"); break;
                    case 8: printf("Agosto"); break;
                    case 9: printf("Septiembre"); break;
                    case 10: printf("Octubre"); break;
                    case 11: printf("Noviembre"); break;
                    case 12: printf("Diciembre"); break;
                }
                printf(" de %d\n", anio);
                break;

            case 2:
                do {
                    printf("\nIngrese cantidad de terminos (> 0): ");
                    if (scanf("%d", &n) != 1) {
                        n = 0;
                    }
                    while (getchar() != '\n');
                } while (n <= 0);

                printf("\n");
                // Fila superior (inicia en 'a', avanza de 2 en 2 dentro de a-z)
                letraSup = 'a';
                for (i = 0; i < n; i++) {
                    printf("%c   ", letraSup);
                    letraSup = (char)(((letraSup - 'a' + 2) % 26) + 'a');
                }
                printf("\n");

                // Fila intermedia de guiones
                for (i = 0; i < n; i++) {
                    printf("-   ");
                }
                printf("\n");

                // Fila inferior (inicia en 'b', avanza de 2 en 2 dentro de a-z)
                letraInf = 'b';
                for (i = 0; i < n; i++) {
                    printf("%c   ", letraInf);
                    letraInf = (char)(((letraInf - 'a' + 2) % 26) + 'a');
                }
                printf("\n");
                break;

            case 3:
                do {
                    printf("\nIngrese cantidad de terminos (>= 0): ");
                    if (scanf("%d", &n) != 1) {
                        n = -1;
                    }
                    while (getchar() != '\n');
                } while (n < 0);

                // Reinicio de valores iniciales en 1 y 5
                a = 1;
                b = 5;

                printf("\n");
                // Imprime parejas completas
                for (i = 0; i < n / 2; i++) {
                    printf("%d, %d", a, b);
                    if (i < (n / 2) - 1 || n % 2 != 0) {
                        printf(", ");
                    }
                    a += 2;
                    b += 2;
                }

                // Si la cantidad solicitada es impar, imprime el ultimo termino de la primera subsecuencia
                if (n % 2 != 0) {
                    printf("%d", a);
                }
                printf("\n");
                break;

            case 4:
                printf("\nGracias! vuelve pronto\n");
                break;

            default:
                printf("\nOpcion no valida\n");
                break;
        }

        if (opcion != 4) {
            printf("\n");
            system("pause");
        }
    } while (opcion != 4);

    return 0;
}
